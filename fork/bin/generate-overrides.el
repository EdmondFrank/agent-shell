;;; generate-overrides.el --- Record the upstream seams the fork leans on  -*- lexical-binding: t; -*-

;; Run from the repository root, with fork/ on the load path:
;;   emacs --batch -Q -L . -L fork -L <acp> -L <shell-maker> -l fork/bin/generate-overrides.el
;;
;; Rewrites fork/overrides.eld with a hash of each upstream definition the
;; overlay hangs off.  `fork/bin/fork-sync' compares the recorded hash with
;; what upstream ships: a mismatch means the seam moved under the fork and
;; the wrapper needs a human look, which is the one thing advice cannot
;; report by itself.

(require 'subr-x)

(require 'agent-shell)
(require 'agent-shell-fork)

;; The seam list lives in fork-seams.el, shared with check-drift.el, so
;; a new wrapper is recorded in one place only.
(require 'fork-seams)

(defun fork-overrides--source (symbol kind)
  "Return SYMBOL's current upstream definition as a string.

An advised function is unwrapped first: the manifest records what
upstream ships, not the fork's own wrapper around it."
  (if (eq kind 'variable)
      (prin1-to-string (symbol-value symbol))
    (if (fboundp symbol)
        (let ((fn (symbol-function symbol)))
          (while (advice--p fn)
            (setq fn (advice--cdr fn)))
          (prin1-to-string fn))
      "")))

(defun fork-overrides--hash (symbol kind)
  "Return a stable hash of SYMBOL's KIND definition."
  (secure-hash 'sha256 (fork-overrides--source symbol kind)))

(with-temp-file (expand-file-name "fork/overrides.eld"
                                  (or (getenv "FORK_ROOT") default-directory))
  (insert ";;; overrides.eld --- upstream seams the fork leans on  -*- lexical-binding: t; -*-\n")
  (insert ";;\n;; Generated by fork/bin/generate-overrides.el.  Each entry records a hash\n")
  (insert ";; of the upstream definition the overlay hooks into, so `fork-sync' can\n")
  (insert ";; tell a harmless upstream commit from one that moved a seam.\n")
  (insert ";;\n;; (SYMBOL KIND WRAPPER HASH NOTE)\n\n")
  (insert "(setq fork-overrides-manifest\n      '(")
  (dolist (entry fork-seam-specs)
    (insert (format "\n        (%s %s %s\n         %S\n         %S)"
                    (car entry) (nth 1 entry)
                    (if (nth 2 entry) (format "#'%s" (nth 2 entry)) "nil")
                    (fork-overrides--hash (car entry) (nth 1 entry))
                    (nth 3 entry))))
  (insert "))\n"))

(message "wrote fork/overrides.eld")